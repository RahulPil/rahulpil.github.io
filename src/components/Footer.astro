---
import { SITE } from '~/config/site';
import SocialLinks from '~/components/SocialLinks.astro';

const year = new Date().getFullYear();
---
<footer class="mt-32 border-t" style="border-color: var(--divider);">
  <div class="mx-auto max-w-6xl px-6 py-12 sm:px-10">
    <div class="flex flex-col gap-8 sm:flex-row sm:items-end sm:justify-between">
      <div>
        <p class="font-display text-2xl tracking-tight" style="color: var(--ink);">
          {SITE.name}<span style="color: var(--accent);">.</span>
        </p>
        <p class="mt-2 text-sm" style="color: var(--muted);">{SITE.location}</p>
      </div>
      <SocialLinks />
    </div>
    <div class="mt-10 flex flex-wrap items-center justify-between gap-2 text-xs" style="color: var(--faint);">
      <span>© {year} {SITE.name}</span>
      <span class="font-mono">built with astro · last updated {new Date().toISOString().slice(0, 10)}</span>
    </div>
  </div>
</footer>
