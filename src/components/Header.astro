---
import { SITE } from '~/config/site';
import ThemeToggle from '~/components/ThemeToggle.astro';

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === '/' ? path === '/' : path.startsWith(href);
---
<header class="site-header sticky top-0 z-50">
  <div class="mx-auto flex max-w-[78rem] items-center justify-between gap-2 px-4 py-5 sm:gap-4 sm:px-10">
    <a href="/" class="logo group" data-cursor aria-label={SITE.name}>
      <span class="font-display text-xl tracking-tight">{SITE.shortName}<span class="logo-dot">.</span></span>
    </a>
    <nav class="flex items-center gap-1 text-sm sm:gap-2">
      {SITE.nav.map((item, i) => (
        <>
          {i > 0 && <span aria-hidden="true" class="nav-sep">·</span>}
          <a
            href={item.href}
            class={`nav-link ${isActive(item.href) ? 'is-active' : ''}`}
            data-cursor
          >
            {item.label}
          </a>
        </>
      ))}
      <span aria-hidden="true" class="nav-sep">·</span>
      <ThemeToggle />
    </nav>
  </div>
</header>

<style>
  .site-header {
    background: color-mix(in srgb, var(--bg) 80%, transparent);
    backdrop-filter: saturate(140%) blur(12px);
    -webkit-backdrop-filter: saturate(140%) blur(12px);
    border-bottom: 1px solid transparent;
    transition: border-color 300ms, background-color 300ms;
  }
  .site-header.is-scrolled {
    border-bottom-color: var(--divider);
  }
  .logo .logo-dot { color: var(--accent); transition: color 300ms; }
  .logo:hover .logo-dot { color: var(--ink); }
  .nav-link {
    padding: 0.25rem 0.5rem;
    color: var(--text);
    position: relative;
    transition: color 250ms;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0.5rem;
    right: 0.5rem;
    bottom: 0.1rem;
    height: 1px;
    background: currentColor;
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-link:hover::after,
  .nav-link.is-active::after { transform: scaleX(1); }
  .nav-link.is-active { color: var(--accent); }
  .nav-sep { color: var(--faint); }

  @media (max-width: 640px) {
    .nav-link {
      padding: 0.25rem 0.35rem;
    }
    .nav-link::after {
      left: 0.35rem;
      right: 0.35rem;
    }
    .nav-sep {
      display: none;
    }
  }
</style>

<script>
  function bindScroll() {
    const header = document.querySelector('.site-header');
    if (!header) return;
    const update = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 8);
    };
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
  bindScroll();
  document.addEventListener('astro:after-swap', bindScroll);
</script>
