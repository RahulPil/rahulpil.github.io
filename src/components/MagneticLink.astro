---
interface Props {
  href: string;
  strength?: number;
  class?: string;
  external?: boolean;
}
const { href, strength = 0.3, class: className = '', external = false } = Astro.props;
const ext = external || /^https?:\/\//.test(href);
---
<a
  href={href}
  class={className}
  data-magnetic
  data-strength={strength}
  data-cursor
  {...(ext ? { target: '_blank', rel: 'noopener noreferrer' } : {})}
>
  <slot />
</a>
