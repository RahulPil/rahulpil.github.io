---
// Animated theme toggle. Uses the View Transitions API for a smooth crossfade.
---
<button
  type="button"
  class="theme-toggle"
  aria-label="Toggle color theme"
  data-cursor
>
  <svg class="t-sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <circle cx="12" cy="12" r="4"/>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.41 1.41M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.41-1.41M17.66 6.34l1.41-1.41"/>
  </svg>
  <svg class="t-moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79Z"/>
  </svg>
</button>

<style>
  .theme-toggle {
    width: 36px;
    height: 36px;
    border-radius: 999px;
    border: 1px solid var(--divider);
    background: transparent;
    color: var(--ink);
    display: inline-flex;
    align-items: center;
    justify-content: center;
    position: relative;
    transition: border-color 300ms, background-color 300ms, transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .theme-toggle:hover {
    border-color: var(--accent);
    background: var(--accent-soft);
    transform: rotate(45deg);
  }
  .theme-toggle svg {
    position: absolute;
    transition: opacity 350ms, transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  :root .theme-toggle .t-sun { opacity: 0; transform: rotate(-90deg) scale(0.7); }
  :root .theme-toggle .t-moon { opacity: 1; transform: rotate(0deg) scale(1); }
  :root.dark .theme-toggle .t-sun { opacity: 1; transform: rotate(0deg) scale(1); }
  :root.dark .theme-toggle .t-moon { opacity: 0; transform: rotate(90deg) scale(0.7); }
</style>

<script>
  function bindToggle() {
    const btns = document.querySelectorAll<HTMLButtonElement>('.theme-toggle');
    btns.forEach((btn) => {
      if (btn.dataset.bound) return;
      btn.dataset.bound = 'true';
      btn.addEventListener('click', () => {
        const next = document.documentElement.classList.contains('dark') ? 'light' : 'dark';
        const apply = () => {
          document.documentElement.classList.toggle('dark', next === 'dark');
          localStorage.setItem('theme', next);
        };
        // Use View Transitions API for crossfade if available
        // @ts-ignore
        if (document.startViewTransition) {
          // @ts-ignore
          document.startViewTransition(apply);
        } else {
          apply();
        }
      });
    });
  }
  bindToggle();
  document.addEventListener('astro:after-swap', bindToggle);
</script>
