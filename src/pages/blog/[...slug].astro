---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Reveal from '~/components/Reveal.astro';
import RevealText from '~/components/RevealText.astro';
import { getCollection, render } from 'astro:content';
import { formatDate, byDateDesc } from '~/lib/format';
import readingTime from 'reading-time';

export async function getStaticPaths() {
  const posts = await getCollection('blog', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content, headings } = await render(post);

const all = (await getCollection('blog', ({ data }) => !data.draft)).sort(byDateDesc);
const idx = all.findIndex((p) => p.id === post.id);
const prev = idx < all.length - 1 ? all[idx + 1] : null;
const next = idx > 0 ? all[idx - 1] : null;

const stats = readingTime(post.body || '');
const tocHeadings = (headings ?? []).filter((h) => h.depth >= 2 && h.depth <= 3);
---
<BaseLayout title={post.data.title} description={post.data.summary}>
  <article class="post-article">
    <header class="article-hero">
      <Reveal>
        <p class="overline">
          <a href="/blog" class="link-underline">Writing</a> · {formatDate(post.data.date)} · {Math.max(1, Math.round(stats.minutes))} min
        </p>
      </Reveal>
      <RevealText as="h1" text={post.data.title} class="display-post" stagger={45} delay={150} />
      <Reveal class="article-summary" delay={500}>
        <hr class="accent-rule" />
        <p>{post.data.summary}</p>
      </Reveal>
    </header>

    <div class="article-layout">
      {tocHeadings.length > 0 && (
        <aside class="toc" aria-label="Table of contents">
          <p class="toc-label font-mono">On this page</p>
          <ol class="toc-list">
            {tocHeadings.map((h) => (
              <li class={`toc-item toc-depth-${h.depth}`}>
                <a href={`#${h.slug}`} class="link-underline" data-cursor>{h.text}</a>
              </li>
            ))}
          </ol>
        </aside>
      )}

      <Reveal class="article-body prose" delay={250}>
        <Content />
      </Reveal>
    </div>

    {(prev || next) && (
      <Reveal class="article-nav" delay={150}>
        <div>
          {prev && (
            <a href={`/blog/${prev.id}`} class="nav-card prev" data-cursor>
              <span class="font-mono text-xs" style="color: var(--faint);">previous</span>
              <span class="nav-title">{prev.data.title}</span>
            </a>
          )}
        </div>
        <div>
          {next && (
            <a href={`/blog/${next.id}`} class="nav-card next" data-cursor>
              <span class="font-mono text-xs" style="color: var(--faint);">next</span>
              <span class="nav-title">{next.data.title}</span>
            </a>
          )}
        </div>
      </Reveal>
    )}
  </article>
</BaseLayout>

<style>
  .post-article {
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(3rem, 8vh, 6rem) 1.5rem 6rem;
  }
  @media (min-width: 640px) { .post-article { padding-left: 2.5rem; padding-right: 2.5rem; } }

  .article-hero { max-width: 68ch; margin: 0 auto 3rem; }
  .overline {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 1.5rem;
  }
  .display-post {
    font-family: var(--font-display);
    font-weight: 400;
    font-variation-settings: "opsz" 144, "SOFT" 50;
    font-size: clamp(2.25rem, 6vw, 4rem);
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--ink);
  }
  .accent-rule {
    width: 4rem;
    border: none;
    border-top: 2px solid var(--accent);
    margin: 2rem 0 1.25rem;
  }
  .article-summary p {
    font-size: 1.125rem;
    line-height: 1.65;
    color: var(--muted);
    font-style: italic;
    font-family: var(--font-display);
    font-variation-settings: "opsz" 24;
  }

  .article-layout {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
  }
  @media (min-width: 1024px) {
    .article-layout { grid-template-columns: 14rem minmax(0, 1fr); gap: 4rem; }
  }

  .toc {
    position: sticky;
    top: 6rem;
    align-self: start;
    max-height: calc(100vh - 8rem);
    overflow-y: auto;
    padding: 0.5rem 0;
  }
  @media (max-width: 1023px) {
    .toc {
      position: static;
      max-height: none;
      border: 1px solid var(--divider);
      padding: 1.25rem 1.25rem 0.5rem;
      background: var(--bg-elevated);
    }
  }
  .toc-label {
    font-size: 0.65rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--faint);
    margin-bottom: 1rem;
  }
  .toc-list { list-style: none; padding: 0; margin: 0; }
  .toc-item { font-size: 0.875rem; line-height: 1.5; padding: 0.3rem 0; color: var(--muted); }
  .toc-depth-3 { padding-left: 1rem; font-size: 0.8125rem; }
  .toc-item a:hover { color: var(--accent); }

  .article-body { max-width: 68ch; margin: 0 auto; }

  .article-nav {
    max-width: 68ch;
    margin: 4rem auto 0;
    padding-top: 2rem;
    border-top: 1px solid var(--divider);
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.5rem;
  }
  .nav-card {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--divider);
    transition: border-color 300ms, transform 350ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .nav-card:hover { border-color: var(--accent); transform: translateY(-2px); }
  .nav-card.next { text-align: right; align-items: flex-end; }
  .nav-title { font-family: var(--font-display); font-size: 1rem; color: var(--ink); line-height: 1.3; }
</style>
