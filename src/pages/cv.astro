---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Reveal from '~/components/Reveal.astro';
---
<BaseLayout title="CV" description="My CV.">
  <section class="cv">
    <Reveal delay={100}>
      <hr class="accent-rule" />
      <p class="intro text-pretty">
        I'm a master's student in computer science at Texas A&amp;M, in the Deep Learning
        Fundamentals Lab under Dr. Tomer Galanti. I'm also a software engineer at Boeing
        on the MQ-25 program. Before grad school I studied at the University of Washington.
        You can download my résumé <a href="/RahulPillalamarri_Resume.pdf" download="RahulPillalamarri_Resume.pdf" class="link-underline link-accent">here</a>.
      </p>
    </Reveal>

    <div class="cv-embed">
      <object
        data="/RahulPillalamarri_Resume.pdf"
        type="application/pdf"
        class="cv-frame"
        aria-label="Resume PDF"
      >
        <p>
          Your browser can't display the PDF inline.
          <a href="/RahulPillalamarri_Resume.pdf" class="link-underline link-accent">Download it here</a>.
        </p>
      </object>
    </div>

    <a
      href="/RahulPillalamarri_Resume.pdf"
      download="RahulPillalamarri_Resume.pdf"
      class="cv-mobile-download"
    >
      <span class="cv-mobile-label font-mono">Resume · PDF</span>
      <span class="cv-mobile-cta">Download my résumé</span>
      <span class="cv-mobile-hint">Inline preview isn't ideal on phones — open the PDF instead.</span>
    </a>
  </section>
</BaseLayout>

<style>
  .cv {
    max-width: 78rem;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }
  @media (min-width: 640px) { .cv { padding-left: 2.5rem; padding-right: 2.5rem; } }

  .accent-rule {
    width: 4rem;
    border: none;
    border-top: 2px solid var(--accent);
    margin: 2.5rem 0 1.5rem;
  }
  .intro {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.65;
    color: var(--muted);
    max-width: none;
    margin: 0 0 2.5rem;
  }

  .cv-embed {
    width: 100%;
    margin-top: 1rem;
  }
  .cv-frame {
    width: 100%;
    height: clamp(500px, 85vh, 900px);
    border: 1px solid var(--divider);
    background: var(--bg-elevated);
    display: block;
  }

  .cv-mobile-download { display: none; }

  @media (max-width: 640px) {
    .cv { padding-bottom: 4rem; }
    .accent-rule { margin: 1.75rem 0 1.25rem; }
    .intro { margin-bottom: 1.75rem; }
    .cv-embed { display: none; }
    .cv-mobile-download {
      display: flex;
      flex-direction: column;
      gap: 0.55rem;
      padding: 1.5rem 1.25rem;
      margin-top: 0.5rem;
      border: 1px solid var(--divider);
      border-left: 3px solid var(--accent);
      background: var(--bg-elevated);
      color: var(--ink);
      text-decoration: none;
      transition: background 200ms, border-color 200ms;
      min-height: 44px;
    }
    .cv-mobile-download:active { background: color-mix(in srgb, var(--accent) 8%, var(--bg-elevated)); }
    .cv-mobile-label {
      font-size: 0.7rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      color: var(--faint);
    }
    .cv-mobile-cta {
      font-family: var(--font-display);
      font-size: 1.4rem;
      line-height: 1.15;
      letter-spacing: -0.01em;
      color: var(--ink);
    }
    .cv-mobile-cta::after {
      content: " ↓";
      color: var(--accent);
    }
    .cv-mobile-hint {
      font-size: 0.85rem;
      color: var(--muted);
      line-height: 1.45;
    }
  }
</style>
