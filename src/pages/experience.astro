---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Reveal from '~/components/Reveal.astro';

const education = [
  {
    school: 'Texas A&M University',
    degree: 'M.S. in Computer Science — concentration in Machine Learning / AI',
    dates: 'Aug 2024 — present',
    notes: 'GPA: 3.50',
  },
  {
    school: 'University of Washington',
    degree: 'B.S. in Computer Science, Minor in Mathematics',
    dates: 'Sept 2021 — Jun 2023',
    notes: 'GPA: 3.51',
  },
];

const research = [
  {
    title: 'Graduate Researcher',
    org: 'Deep Learning Fundamentals Lab, Texas A&M CSE — advised by Dr. Tomer Galanti',
    dates: 'Jun 2025 — present',
    bullets: [
      'Directional Geometric Loss for Robust Fine-Tuning: designed a loss function grounded in neural-collapse and contrastive-learning theory to fine-tune CLIP, mitigating catastrophic forgetting while achieving comparable downstream performance on ImageNet-1K.',
      'Comparative Study of Reasoning Models: evaluated the Hierarchical Reasoning Model (HRM) against state-of-the-art LLM baselines (Mistral, BLOOM, Llama) on pattern recognition and graph-reasoning tasks.',
      "High Performance Computing: wrote multi-threaded, multi-GPU training pipelines in Python to run large-scale experiments on TAMU's Grace A100 cluster and cloud H100 servers.",
    ],
  },
];

const work = [
  {
    title: 'Software Engineer (Secret clearance)',
    org: 'Boeing — St. Louis, MO',
    dates: 'Sept 2023 — present',
    bullets: [
      'Real-time embedded systems: implemented integral services to enable autonomous flight control of the MQ-25 refueller in C++ using multi-threading and live data streams at the bit level.',
      'Testing & validation: developed scripts to accelerate operational flight program validation in Hardware-in-the-Loop (HIL) environments, improving testing speed by 60%.',
      'Image analysis: created a test pipeline leveraging OpenCV-based image analysis to validate flight systems.',
    ],
  },
  {
    title: 'Software Engineer Intern',
    org: 'MCG Health — Seattle, WA',
    dates: 'Jun 2023 — Sept 2023',
    bullets: [
      'API development: designed and deployed APIs in C# on Azure to speed up authoring and testing of XML evidence-based healthcare guidelines by 30%.',
      'API testing: wrote unit tests using Moq and Fluent-Assertions for micro-service testing.',
    ],
  },
  {
    title: 'Software Engineer Intern',
    org: 'Sensoria Health — Redmond, WA',
    dates: 'Aug 2021 — Oct 2022',
    bullets: [
      'Android development: built two mobile applications in Java and Kotlin to configure and gather data from company health-tech devices, bridging the physician and patient gap during rehabilitation.',
      'Cloud systems: integrated Google Cloud Platform Firebase into mobile applications to implement data pipelines transmitting patient recovery data to physicians.',
    ],
  },
];

const skills: Record<string, string[]> = {
  Languages: ['Python', 'C / C++', 'C#', 'JavaScript', 'Java', 'MATLAB', 'SQL', 'Kotlin', 'Bash', 'XML'],
  Technologies: ['PyTorch', 'TensorFlow', 'sklearn', 'CUDA', 'OpenCV', 'AWS', 'Azure', 'Spark', 'Hadoop', 'React', 'Android Studio'],
  Areas: ['Machine Learning / AI', 'Deep Learning', 'NLP', 'Big Data', 'Real-Time Embedded Systems', 'High Performance Computing'],
};
---
<BaseLayout title="Experience" description="Education, research, and work.">
  <section class="cv">
    <Reveal delay={100}>
      <hr class="accent-rule" />
      <p class="intro text-pretty">
        I'm a master's student in computer science at Texas A&amp;M, in the Deep Learning
        Fundamentals Lab under Dr. Tomer Galanti. I'm also a software engineer at Boeing
        on the MQ-25 program. Before grad school I studied at the University of Washington.
        You can download my résumé <a href="/RahulPillalamarri_Resume.pdf" download="RahulPillalamarri_Resume.pdf" class="link-underline link-accent">here</a>.
      </p>
    </Reveal>

    <div class="cv-grid">
      <Reveal class="cv-section">
        <h2 class="cv-section-title">Education</h2>
        <ul class="cv-list">
          {education.map((e) => (
            <li class="cv-item">
              <div class="cv-item-head">
                <span class="cv-item-title">{e.school}</span>
                <span class="cv-item-date font-mono">{e.dates}</span>
              </div>
              <p class="cv-item-org">{e.degree}</p>
              {e.notes && <p class="cv-item-notes">{e.notes}</p>}
            </li>
          ))}
        </ul>
      </Reveal>

      <Reveal class="cv-section" delay={100}>
        <h2 class="cv-section-title">Research</h2>
        <ul class="cv-list">
          {research.map((r) => (
            <li class="cv-item">
              <div class="cv-item-head">
                <span class="cv-item-title">{r.title}</span>
                <span class="cv-item-date font-mono">{r.dates}</span>
              </div>
              <p class="cv-item-org">{r.org}</p>
              <ul class="cv-bullets">
                {r.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </Reveal>

      <Reveal class="cv-section" delay={150}>
        <h2 class="cv-section-title">Work</h2>
        <ul class="cv-list">
          {work.map((w) => (
            <li class="cv-item">
              <div class="cv-item-head">
                <span class="cv-item-title">{w.title}</span>
                <span class="cv-item-date font-mono">{w.dates}</span>
              </div>
              <p class="cv-item-org">{w.org}</p>
              <ul class="cv-bullets">
                {w.bullets.map((b) => <li>{b}</li>)}
              </ul>
            </li>
          ))}
        </ul>
      </Reveal>

      <Reveal class="cv-section" delay={200}>
        <h2 class="cv-section-title">Skills</h2>
        <dl class="skill-list">
          {Object.entries(skills).map(([group, items]) => (
            <div class="skill-row">
              <dt>{group}</dt>
              <dd>{items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </Reveal>

    </div>
  </section>
</BaseLayout>

<style>
  .cv {
    max-width: 78rem;
    margin: 0 auto;
    padding: 0 1.5rem 6rem;
  }
  @media (min-width: 640px) { .cv { padding-left: 2.5rem; padding-right: 2.5rem; } }

  .accent-rule {
    width: 4rem;
    border: none;
    border-top: 2px solid var(--accent);
    margin: 2.5rem 0 1.5rem;
  }
  .intro {
    font-size: clamp(1.05rem, 1.5vw, 1.2rem);
    line-height: 1.65;
    color: var(--muted);
    max-width: none;
    margin: 0 0 2.5rem;
  }

  .cv-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3.5rem;
  }

  .cv-section-title {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 2.5vw, 1.65rem);
    font-variation-settings: "opsz" 60, "SOFT" 30;
    line-height: 1.1;
    color: var(--ink);
    margin: 0 0 1.5rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--ink);
  }

  .cv-list { list-style: none; padding: 0; margin: 0; }
  .cv-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--divider);
  }
  .cv-item:last-child { border-bottom: none; }
  .cv-item-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }
  .cv-item-title {
    font-family: var(--font-display);
    font-size: 1.1rem;
    font-variation-settings: "opsz" 24;
    color: var(--ink);
    letter-spacing: -0.005em;
  }
  .cv-item-date { font-size: 0.75rem; color: var(--faint); }
  .cv-item-org { color: var(--muted); font-size: 0.95rem; margin: 0 0 0.5rem; }
  .cv-item-notes { color: var(--muted); font-size: 0.875rem; margin: 0.25rem 0 0; }
  .cv-bullets { list-style: none; padding: 0; margin: 0.5rem 0 0; }
  .cv-bullets li {
    color: var(--text);
    font-size: 0.95rem;
    line-height: 1.6;
    padding: 0.25rem 0 0.25rem 1.25rem;
    position: relative;
  }
  .cv-bullets li::before {
    content: "—";
    position: absolute;
    left: 0;
    color: var(--accent);
  }

  .skill-list { margin: 0; display: grid; gap: 1rem; }
  .skill-row {
    display: grid;
    grid-template-columns: 1fr;
    gap: 0.25rem;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--divider);
  }
  .skill-row:last-child { border-bottom: none; }
  @media (min-width: 700px) {
    .skill-row { grid-template-columns: 8rem 1fr; gap: 1.5rem; align-items: baseline; }
  }
  .skill-row dt {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.18em;
    color: var(--faint);
  }
  .skill-row dd {
    margin: 0;
    font-size: 0.95rem;
    color: var(--text);
    line-height: 1.6;
  }
</style>
