---
import BaseLayout from '~/layouts/BaseLayout.astro';
import Reveal from '~/components/Reveal.astro';
import MagneticLink from '~/components/MagneticLink.astro';
import SocialLinks from '~/components/SocialLinks.astro';
import { SITE } from '~/config/site';
import { getCollection } from 'astro:content';
import { isoMonth } from '~/lib/format';

const notes = await getCollection('notes', ({ data }) => !data.draft);
const blog = await getCollection('blog', ({ data }) => !data.draft);

type Item = { href: string; title: string; kind: string; date: Date };
const allItems: Item[] = [
  ...notes.map((n) => ({ href: `/notes/${n.id}`, title: n.data.title, kind: 'Notes', date: n.data.date })),
  ...blog.map((b) => ({ href: `/blog/${b.id}`, title: b.data.title, kind: 'Writing', date: b.data.date })),
]
  .sort((a, b) => b.date.getTime() - a.date.getTime())
  .slice(0, 6);
---
<BaseLayout>
  <section class="hero">
    <div class="hero-grid">
      <div class="hero-left">
        <Reveal as="h1" class="display-xl" delay={100}>
          RAHUL<br /><span class="pillalamarri">PILLALAMARRI</span>
        </Reveal>
        <Reveal class="hero-sub" delay={350}>
          <p class="lead text-pretty">
            Master's student in computer science at <span style="color: var(--ink);">Texas A&amp;M</span>,
            working with Tomer Galanti on deep learning. Also a software engineer at Boeing.
          </p>
          <SocialLinks class="mt-6" />
        </Reveal>
      </div>
      <div class="hero-right">
        <Reveal delay={500}>
          <figure class="photo">
            <img src="/profile.jpeg" alt={SITE.name} width="288" height="384" loading="eager" />
          </figure>
        </Reveal>
      </div>
    </div>
  </section>

  <section class="section about-snip">
    <hr class="section-divider" />
    <Reveal class="section-header">
      <h2 class="display-md">About Me<span style="color: var(--accent);">.</span></h2>
    </Reveal>
    <div class="about-grid">
      <Reveal class="about-body about-body--wide" delay={120}>
        <p>
          I'm a master's student in computer science at Texas A&amp;M, advised by
          <a href="https://tomergalanti.github.io" class="link-underline" target="_blank" rel="noopener">Tomer Galanti</a>
          in the Deep Learning Fundamentals Lab. My research focuses on robust fine-tuning,
          reasoning models, and the geometry of learned representations.
        </p>
        <p>
          I'm also a software engineer at Boeing, working on real-time embedded systems
          for the MQ-25 program. Before grad school I studied computer science at the
          University of Washington.
        </p>
      </Reveal>
      <div class="about-aside">
        <MagneticLink href="/cv" class="cta-link">Full background →</MagneticLink>
      </div>
    </div>
  </section>

  <section class="section">
    <hr class="section-divider" />
    <Reveal class="section-header">
      <h2 class="display-md">Research<span style="color: var(--accent);">.</span></h2>
    </Reveal>
    <Reveal class="about-body about-body--wide" delay={120}>
      <p>
        Currently working in the Deep Learning Fundamentals Lab at Texas A&amp;M
        under Dr. Tomer Galanti, on questions around robust fine-tuning and the
        geometry of learned representations. More detailed write-ups, project
        pages, and links to come.
      </p>
    </Reveal>
  </section>

  <section id="recently" class="section">
    <hr class="section-divider" />
    <Reveal class="section-header">
      <h2 class="display-md">Posts<span style="color: var(--accent);">.</span></h2>
    </Reveal>

    <Reveal>
      <p class="section-subtitle">This is where you can find some of my recent thoughts.</p>
    </Reveal>

    {allItems.length > 0 && (
      <ul class="recent-list">
        {allItems.map((item, i) => (
          <Reveal as="li" delay={i * 70}>
            <a href={item.href} class="recent-row">
              <span class="recent-num">{String(i + 1).padStart(2, '0')}</span>
              <span class="recent-title">{item.title}</span>
              <span class="recent-meta">
                <span class="recent-kind">{item.kind}</span>
                <span class="dot">·</span>
                <span class="font-mono">{isoMonth(item.date)}</span>
              </span>
              <span class="recent-arrow" aria-hidden="true">↗</span>
            </a>
          </Reveal>
        ))}
      </ul>
    )}

    <Reveal class="recent-cta" delay={300}>
      <MagneticLink href="/notes" class="cta-link">All notes</MagneticLink>
      <MagneticLink href="/blog" class="cta-link">All writing</MagneticLink>
    </Reveal>
  </section>

  <section class="section">
    <hr class="section-divider" />
    <Reveal class="section-header">
      <h2 class="display-md">Off The Clock<span style="color: var(--accent);">.</span></h2>
    </Reveal>
    <Reveal class="about-body about-body--wide" delay={120}>
      <p>
        Outside the lab and the hangar, I read across disciplines — usually whatever
        sits at the seam between math, systems, and the humanities — and build small
        side projects to chew on ideas I don't yet understand. I'm most interested in
        the places where clean theory meets messy practice, and I try to learn most
        things in public.
      </p>
    </Reveal>
  </section>
</BaseLayout>

<style>
  .hero {
    position: relative;
    padding: clamp(1.5rem, 5vh, 3.5rem) 1.5rem clamp(2rem, 6vh, 4rem);
    max-width: 78rem;
    margin: 0 auto;
  }
  @media (min-width: 640px) { .hero { padding-left: 2.5rem; padding-right: 2.5rem; } }

  .hero-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 3rem;
    align-items: end;
  }
  @media (min-width: 900px) {
    .hero-grid { grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 5rem; }
  }

  .overline {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 2rem;
  }

  .display-md {
    font-family: var(--font-display);
    font-weight: 400;
    font-variation-settings: "opsz" 100, "SOFT" 40;
    font-size: clamp(2rem, 5vw, 3.5rem);
    line-height: 1;
    letter-spacing: -0.025em;
    color: var(--ink);
  }

  .lead {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.65;
    color: var(--muted);
    max-width: none;
    margin-top: 2rem;
  }

  .hero-right { display: flex; justify-content: flex-end; }
  .photo {
    margin: 0 0.7cm 0 0;
    width: clamp(11rem, 26vw, 18rem);
  }
  .photo img {
    width: 100%;
    aspect-ratio: 3 / 4;
    object-fit: cover;
    background: var(--bg-elevated);
    border: 1px solid var(--divider);
  }

  .section {
    max-width: 78rem;
    margin: 0 auto;
    padding: clamp(2rem, 5vh, 3.5rem) 1.5rem;
  }
  @media (min-width: 640px) { .section { padding-left: 2.5rem; padding-right: 2.5rem; } }

  .section-divider {
    border: none;
    border-top: 1px solid var(--divider);
    margin: 0 0 0.75rem;
  }

  .section-subtitle {
    font-size: clamp(1rem, 1.4vw, 1.125rem);
    line-height: 1.6;
    color: var(--muted);
    max-width: 52ch;
    margin: 0 0 2.5rem;
  }

  .recent-list {
    list-style: none;
    padding: 0;
    margin: 0;
    border-top: 1px solid var(--divider);
  }
  .recent-row {
    display: grid;
    grid-template-columns: auto 1fr auto auto;
    align-items: baseline;
    gap: 1.25rem;
    padding: 1.25rem 0.25rem;
    border-bottom: 1px solid var(--divider);
    position: relative;
    transition: padding-left 500ms cubic-bezier(0.16, 1, 0.3, 1), color 300ms;
  }
  .recent-row:hover { padding-left: 1.25rem; }
  .recent-row::before {
    content: "";
    position: absolute;
    left: 0;
    top: 50%;
    width: 0.75rem;
    height: 1px;
    background: var(--accent);
    transform: translate(-1rem, -50%) scaleX(0);
    transform-origin: left;
    transition: transform 500ms cubic-bezier(0.16, 1, 0.3, 1);
  }
  .recent-row:hover::before { transform: translate(0.25rem, -50%) scaleX(1); }
  .recent-num {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--faint);
    align-self: center;
    width: 1.75rem;
  }
  .recent-title {
    font-family: var(--font-display);
    font-size: clamp(1.05rem, 2vw, 1.35rem);
    color: var(--ink);
    font-variation-settings: "opsz" 36;
    letter-spacing: -0.01em;
  }
  .recent-meta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .recent-kind {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.15em;
  }
  .recent-meta .dot { color: var(--faint); }
  .recent-arrow {
    color: var(--faint);
    transition: color 300ms, transform 300ms;
  }
  .recent-row:hover .recent-arrow { color: var(--accent); transform: translate(2px, -2px); }
  @media (max-width: 700px) {
    .recent-row {
      grid-template-columns: auto 1fr auto;
      grid-template-rows: auto auto;
      column-gap: 0.75rem;
      row-gap: 0.25rem;
    }
    .recent-meta { grid-column: 2 / 3; }
    .recent-arrow { grid-row: 1 / 2; }
  }

  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }
  @media (min-width: 900px) {
    .about-grid { grid-template-columns: minmax(0, 3fr) minmax(0, 1fr); gap: 4rem; align-items: center; }
  }

  /* ---------- Mobile overrides (≤ 640px) ---------- */
  @media (max-width: 640px) {
    /* Belt-and-suspenders: clip anything that bleeds past the hero box */
    .hero { overflow-x: hidden; }
    /* Grid items must be allowed to shrink past their content's intrinsic size,
       otherwise a wide child (e.g. the nowrap PILLALAMARRI) will expand the track */
    .hero-grid > * { min-width: 0; }
    .hero-left { max-width: 100%; min-width: 0; }

    /* Hero typography: shrink so PILLALAMARRI (nowrap, 13 chars) fits a 360-402px viewport.
       !important is required because global.css sets `.display-xl { font-size: 4rem !important }`,
       which would otherwise win the cascade despite our higher-specificity selector. */
    .hero :global(.display-xl) {
      font-size: clamp(0.9rem, 6vw, 1.625rem) !important;
      letter-spacing: -0.02em;
      overflow-wrap: normal;
    }
    .hero :global(.pillalamarri) { white-space: nowrap; }

    /* Hero photo: center under the hero text instead of hugging the right edge.
       Belt-and-suspenders: 3 centering layers (flex on .hero-right, flex on the
       Reveal wrapper, margin:auto on .photo) so the photo lands centered even if
       one layer fails. */
    .hero-right {
      display: flex;
      justify-content: center;
      align-items: center;
      width: 100%;
      max-width: 100%;
      margin-top: 0.5rem;
    }
    .hero-right :global([data-reveal]) {
      margin: 0 auto;
      width: 100%;
      max-width: 100%;
      display: flex;
      justify-content: center;
    }
    .photo {
      margin: 0 auto;
      display: block;
      width: min(50vw, 11rem);
      max-width: 100%;
    }
    .photo img {
      display: block;
      width: 100%;
      height: auto;
    }

    /* Tighten horizontal padding to a balanced 1.25rem on the smallest phones,
       and compress vertical rhythm slightly */
    .hero { padding: clamp(1rem, 4vh, 2.5rem) 1.25rem clamp(1.25rem, 4vh, 2.5rem); }
    .section { padding: 1.75rem 1.25rem; }
    .hero-grid { gap: 1.25rem; }

    /* Lead and body copy: tighten font size and ensure no horizontal overflow */
    .lead { font-size: 0.9375rem; line-height: 1.55; margin-top: 1.25rem; }
    .section-subtitle { font-size: 1rem; line-height: 1.55; margin-bottom: 1.75rem; }

    /* Section header breathing room */
    .section-divider { margin-bottom: 1rem; }
    .display-md { font-size: clamp(1.75rem, 8vw, 2.25rem); }
  }

  /* ---------- Posts list mobile polish (≤ 700px) ---------- */
  @media (max-width: 700px) {
    .recent-row {
      grid-template-columns: auto minmax(0, 1fr) auto;
      padding: 1rem 0.25rem;
    }
    .recent-title {
      font-size: 1.05rem;
      overflow-wrap: break-word;
      word-break: break-word;
      min-width: 0;
    }
    .recent-row:hover { padding-left: 0.25rem; }
    .recent-cta { display: flex; flex-wrap: wrap; gap: 1rem; }
  }

  /* ---------- Posts list: simplify on small phones to match Notes/Writing index ---------- */
  @media (max-width: 640px) {
    /* Drop the visual noise — these are the elements the index pages don't show */
    .recent-num,
    .recent-kind,
    .recent-meta .dot,
    .recent-arrow { display: none; }

    /* Restructure: date (mono, small) stacked above title — mimics .note-row at ≤640px */
    .recent-row {
      grid-template-columns: 1fr;
      grid-template-rows: auto auto;
      gap: 0.35rem;
      padding: 1rem 0;
      align-items: start;
    }

    /* Date sits above the title, in mono, faint */
    .recent-meta {
      grid-row: 1;
      grid-column: 1;
      font-size: 0.7rem;
      letter-spacing: 0.12em;
      color: var(--faint);
      gap: 0;
    }

    /* Title takes the second row */
    .recent-title {
      grid-row: 2;
      grid-column: 1;
      font-size: 1.1rem;
      line-height: 1.25;
    }

    /* Strip the hover padding-shift and the accent rule — pointless on touch */
    .recent-row:hover { padding-left: 0; }
    .recent-row::before { display: none; }
  }
</style>
