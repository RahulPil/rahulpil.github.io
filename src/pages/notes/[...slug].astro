---
import BaseLayout from '~/layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';
import { formatDate } from '~/lib/format';

export async function getStaticPaths() {
  const notes = await getCollection('notes', ({ data }) => !data.draft);
  return notes.map((note) => ({ params: { slug: note.id }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---
<BaseLayout title={note.data.title} description={note.data.summary || `${note.data.topic} — note by Rahul Pillalamarri`}>
  <section class="post">
    <a href="/notes" class="back-link">← notes</a>

    <header class="post-header">
      <h1 class="post-title">{note.data.title}</h1>
      <hr class="post-rule" />
      <p class="post-meta">{note.data.topic} · {formatDate(note.data.date)}</p>
    </header>

    <div class="post-body prose">
      <Content />
    </div>
  </section>
</BaseLayout>

<style>
  .post {
    max-width: 68ch;
    margin: 0 auto;
    padding: clamp(2rem, 5vh, 3.5rem) 1.5rem 6rem;
  }
  @media (min-width: 640px) {
    .post { padding-left: 2.5rem; padding-right: 2.5rem; }
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0.25rem 0;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin-bottom: 2rem;
    transition: color 200ms;
  }
  .back-link:hover { color: var(--accent); }

  .post-header { margin-bottom: 3rem; }
  .post-title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 5vw, 3.25rem);
    font-variation-settings: "opsz" 144, "SOFT" 50;
    line-height: 1.05;
    letter-spacing: -0.025em;
    color: var(--ink);
    margin: 0;
  }
  .post-rule {
    width: 6rem;
    border: none;
    border-top: 2px solid var(--accent);
    margin: 1.5rem 0 1.5rem;
  }
  .post-meta {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: var(--muted);
    margin: 0;
    word-break: break-word;
  }

  @media (max-width: 640px) {
    .post {
      padding-left: 1.25rem;
      padding-right: 1.25rem;
      padding-bottom: 4rem;
    }
    .back-link { margin-bottom: 1.5rem; }
    .post-header { margin-bottom: 2rem; }
    .post-title {
      font-size: clamp(1.75rem, 8vw, 2.25rem);
      line-height: 1.1;
      letter-spacing: -0.02em;
      overflow-wrap: break-word;
    }
    .post-rule {
      width: 3rem;
      margin: 1rem 0;
    }
    .post-meta {
      font-size: 0.7rem;
      letter-spacing: 0.12em;
    }
  }
</style>
